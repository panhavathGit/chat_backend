NODE_ENV=development
PORT=3000

# Local Homebrew Postgres, using the postgres superuser (add :password after "postgres" if yours has one)
DATABASE_URL="postgresql://postgres@localhost:5432/chat_backend?schema=public"

# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed origins; leave empty to allow all in development
CORS_ORIGIN=
