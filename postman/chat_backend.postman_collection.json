{
  "info": {
    "name": "Chat Backend",
    "description": "End-to-end tests for the Chat Backend API (auth + post CRUD).\n\nRun the whole collection in order (Postman Collection Runner, or `pnpm dlx newman run postman/chat_backend.postman_collection.json`). Each run registers two fresh users (Alice and Bob) with unique emails, so it can be re-run any number of times.\n\nRequests save `tokenA`, `tokenB` and `postId` into collection variables for the requests that follow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiUrl", "value": "{{baseUrl}}/customer/api/v1" },
    { "key": "password", "value": "password123" },
    { "key": "emailA", "value": "" },
    { "key": "emailB", "value": "" },
    { "key": "tokenA", "value": "" },
    { "key": "tokenB", "value": "" },
    { "key": "postId", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code !== 204) {",
          "  pm.test('Response is JSON with a status field', () => {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('status');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is success', () => pm.expect(pm.response.json().status).to.eql('success'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route returns 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('error code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - invalid body (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const error = pm.response.json().error;",
                  "pm.test('error code BAD_REQUEST', () => pm.expect(error.code).to.eql('BAD_REQUEST'));",
                  "pm.test('field errors for email and password', () => {",
                  "  pm.expect(error.details).to.have.property('email');",
                  "  pm.expect(error.details).to.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Alice (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Alice\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailA', `alice.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.test('returns user and accessToken', () => {",
                  "  pm.expect(result.user.email).to.eql(pm.collectionVariables.get('emailA'));",
                  "  pm.expect(result.accessToken).to.be.a('string');",
                  "});",
                  "pm.test('never returns the password hash', () => pm.expect(result.user).to.not.have.property('passwordHash'));",
                  "pm.collectionVariables.set('tokenA', result.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('error code CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('error code UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Alice (200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.test('returns accessToken', () => pm.expect(result.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('tokenA', result.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - no token (401)",
          "request": {
            "method": "GET",
            "url": "{{apiUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - invalid token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not.a.real.token" }],
            "url": "{{apiUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{apiUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the logged-in user', () => pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('emailA')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post - no token (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/posts",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Should fail\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post - invalid body (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "url": "{{apiUrl}}/posts",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('field error for title', () => pm.expect(pm.response.json().error.details).to.have.property('title'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "url": "{{apiUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello from Postman\",\n  \"content\": \"My first post\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const post = pm.response.json().data;",
                  "pm.test('post has id, title and defaults to unpublished', () => {",
                  "  pm.expect(post.id).to.be.a('string');",
                  "  pm.expect(post.title).to.eql('Hello from Postman');",
                  "  pm.expect(post.published).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set('postId', post.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my posts (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": {
              "raw": "{{apiUrl}}/posts?page=1&size=10",
              "host": ["{{apiUrl}}"],
              "path": ["posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('data is an array containing the new post', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.data.map((p) => p.id)).to.include(pm.collectionVariables.get('postId'));",
                  "});",
                  "pm.test('meta has pagination fields', () => {",
                  "  pm.expect(body.meta).to.include.keys('total', 'page', 'size', 'totalPages');",
                  "  pm.expect(body.meta.page).to.eql(1);",
                  "  pm.expect(body.meta.size).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List posts - invalid size (400)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": {
              "raw": "{{apiUrl}}/posts?size=500",
              "host": ["{{apiUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "size", "value": "500" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request (size max is 100)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post by id (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{apiUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the right post', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('postId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post - invalid id (400)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{apiUrl}}/posts/not-a-uuid"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post - unknown id (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{apiUrl}}/posts/00000000-0000-4000-8000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update post - empty body (400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "url": "{{apiUrl}}/posts/{{postId}}",
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request (at least one field required)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update post (200)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "url": "{{apiUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello from Postman (edited)\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const post = pm.response.json().data;",
                  "pm.test('title updated, content kept', () => {",
                  "  pm.expect(post.title).to.eql('Hello from Postman (edited)');",
                  "  pm.expect(post.content).to.eql('My first post');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Ownership (second user)",
      "item": [
        {
          "name": "Register Bob (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Bob\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailB', `bob.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tokenB', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob gets Alice's draft (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": "{{apiUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 - unpublished posts are hidden from other users', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob updates Alice's post (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenB}}" }
            ],
            "url": "{{apiUrl}}/posts/{{postId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Hacked\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('error code FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob deletes Alice's post (403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": "{{apiUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alice publishes the post (200)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenA}}" }
            ],
            "url": "{{apiUrl}}/posts/{{postId}}",
            "body": { "mode": "raw", "raw": "{\n  \"published\": true\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('published is true', () => pm.expect(pm.response.json().data.published).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bob gets Alice's published post (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": "{{apiUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - published posts are visible to everyone', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete post (204)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{apiUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted post (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": "{{apiUrl}}/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
